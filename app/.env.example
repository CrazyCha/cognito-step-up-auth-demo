# Copy this file to .env and fill in values from `cdk deploy --outputs-file .cdk-outputs.json`

# From CDK outputs
USER_POOL_ID=us-east-1_XXXXXXXXX
CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Test user credentials (created by `node src/setup.js`)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPass1!

# Booking threshold — must match the value configured in the CDK stack (default: 5000).
# The app enforces this threshold itself (Cognito Lambda triggers cannot receive
# clientMetadata from InitiateAuth — see DECISIONS.md ADR-007).
BOOKING_THRESHOLD=5000

# Booking amount for the demo. Try 3000 (no step-up) and 8000 (triggers step-up).
BOOKING_AMOUNT=8000
